{
  "name": "tPlan",
  "version": "1.0.0",
  "description": "Application de gestion de tâches.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "tplan",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "mac": {
      "icon": "icon.icns"
    },
    "linux": {
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "uninstallDisplayName": "tPlan",
      "license": "LICENSE",
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": [],
  "author": "Institut G4 | B1",
  "contributors": [
    {
      "name": "RIBOTE--MORAL Noa"
    },
    {
      "name": "SUBLET Loïc"
    },
    {
      "name": "SMATTI Abdelaziz"
    },
    {
      "name": "MEZA FLOR Luis fernando"
    }
  ],
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.11.8",
    "electron-builder": "^26.15.3",
    "electron-packager": "^14.2.1"
  }
}
